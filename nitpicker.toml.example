[defaults]
debate = true
# Try the next configured reviewer when a provider/model fails.
# fallback = true
max_turns = 200
log_trajectories = true
compact_threshold = 120000
# Ordered review-angle selection; CLI --preset overrides it per run.
# presets = ["correctness", "security", "performance", "simplicity"]

[aggregator]
model = "claude-sonnet-5"
provider = "anthropic"
# api_key_env = "ANTHROPIC_API_KEY"  # default; override if needed

# OpenRouter with automatic free-model selection (omit model field)
[[reviewer]]
name = "openrouter-free-a"
provider = "openrouter"

[[reviewer]]
name = "openrouter-free-b"
provider = "openrouter"

# [[reviewer]]
# name = "anthropic"
# model = "claude-sonnet-5"
# provider = "anthropic"

# Gemini via Antigravity keyring (research only — reuses the agy CLI token).
# Requires building with `--features antigravity` (off by default).
# [[reviewer]]
# name = "gemini"
# model = "gemini-3.5-flash-low"
# provider = "gemini"
# auth = "agy-keyring"

# [[reviewer]]
# name = "openai"
# model = "gpt-5.6-sol"
# provider = "openai"

# ChatGPT/Codex subscription (research only — reuses the Codex CLI token from
# ~/.codex/auth.json; no API key needed). Run `codex login` first.
# [[reviewer]]
# name = "codex"
# model = "gpt-5.6-sol"
# provider = "openai"
# auth = "codex"

# OpenRouter with explicit model
# [[reviewer]]
# name = "openrouter"
# model = "minimax/minimax-m3"
# provider = "openrouter"

# --- Review presets ---------------------------------------------------------
# A preset is one named review angle. Universal defaults: correctness, security,
# performance, simplicity. Opt-in built-ins: ai-systems, ml-rigor, tone, and the
# standalone broad-review preset general. Review runs resolve
# --preset > [defaults].presets (see the [defaults] block at the top) > the
# built-in four (correctness, security, performance, simplicity).
# Parallel mode runs reviewers × presets jobs; debate mode runs one concurrent
# debate lane per preset — spend and wall-clock scale with the selection size.
# `general` cannot be combined with another preset.
#
# Define a project preset (a table with the same name as a built-in replaces it):
# [presets.api-security]
# prompt = """
# Review trust boundaries, authentication, authorization, input handling, and
# secret exposure. Require a concrete attacker-controlled path and plausible
# impact for every finding.
# """
